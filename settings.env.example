CONTROL_PLANE_IP=1.1.1.1
CLUSTER_NAME=my-cluster
INSTALL_DISK="/dev/sda"
TALOS_BASIC_STORAGE=true
TALOS_BASIC_STORAGE_SIZE=200GB
WORKLOADS_ON_CONTROLPLANE=true
INFRA_REPO_URL=https://github.com/org/infra
GITHUB_APP_NAME=my-cluster-flux
# Leave unset to create an app for the authenticated user.
GITHUB_APP_ORGANIZATION=
# Optional public App homepage. The manifest callback is handled locally.
GITHUB_APP_PRIVATE_KEY=secrets/flux-gh-app.private-key.pem